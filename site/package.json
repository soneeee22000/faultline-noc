{
  "name": "faultline-noc-site",
  "private": true,
  "version": "0.1.0",
  "description": "Project page for Faultline NOC, an evaluation harness for network-ops RCA agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "capture": "node scripts/capture.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "lucide": "1.46.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
